# GTM Presentations: environment variable NAMES only. Never commit real values.
# Each process reads its own subset; the section headers say which one.

# ---------------------------------------------------------------------------
# App (Next.js, PM2 on the VPS; locally in .env.local)
# ---------------------------------------------------------------------------
# Postgres connection string used by Drizzle (self-hosted Postgres on the VPS in production)
DATABASE_URL=
# NextAuth v5 session/JWT signing secret (read implicitly by next-auth)
AUTH_SECRET=
# Google OAuth client id for sign-in (src/lib/auth.ts)
GOOGLE_CLIENT_ID=
# Google OAuth client secret for sign-in (src/lib/auth.ts)
GOOGLE_CLIENT_SECRET=
# Comma-separated emails that resolve to the super_admin role (and may use "View as")
SUPER_ADMIN_EMAILS=
# Shared secret the relay and the engage worker send as x-relay-secret to /api/create/{next,progress,done}
RELAY_SECRET=
# Public hostname of the app, server side (booking links, export capture host mapping), e.g. app.example.com
APP_DOMAIN=
# Public hostname of the app, client side (share links built in the browser), e.g. app.example.com
NEXT_PUBLIC_APP_DOMAIN=
# Absolute path of engage-scout.mjs on the server (used by POST /api/create/scout)
ENGAGE_SCOUT=

# ---------------------------------------------------------------------------
# Engage worker (workers/engage, PM2 "engage-worker" on the VPS; reads <WORKERS_DIR>/.env)
# Also needs RELAY_SECRET and APP_DOMAIN from above.
# ---------------------------------------------------------------------------
# Anthropic API key for the writer, logo/photo pickers and visual slide checks
ANTHROPIC_API_KEY=
# Claude model id for the engage worker (defaults in code when empty)
ENGAGE_MODEL=
# Base URL of the app as seen from the worker, normally http://127.0.0.1:3000
ENGAGE_APP=
# Folder for cached web image-search results used by the logo search
ENGAGE_SEARCH_CACHE=

# ---------------------------------------------------------------------------
# Local relay + create-engine (engine/create-engine, LaunchAgent on a Mac; reads relay.env)
# Also needs ANTHROPIC_API_KEY and RELAY_SECRET from above.
# ---------------------------------------------------------------------------
# Full base URL of the app the relay polls, e.g. https://app.example.com (overrides APP_DOMAIN)
APP_URL=
# ssh target the relay uses to copy spool files and publish decks, e.g. deploy@<VPS_HOST>
VPS_SSH=
# Alternative name for the Anthropic key, read only when ANTHROPIC_API_KEY is empty
CLAUDE_API_KEY=
# Claude model id for generate.mjs (accepts "anthropic/<id>" and normalises it)
CREATE_MODEL=
# Claude model id for qa-pass.mjs and the build-one generation env
GEN_MODEL=
# Set to 0 to stop sending rendered page images to the model (vision is on by default)
CREATE_VISION=
# Set to 1 to enable the balanced palette and "use every source asset" style directives
GEN_STYLE2=
# Set to 1 to allow bespoke "novel" slides designed as HTML fragments for layouts no template fits
GEN_NOVEL=
# Set to 1 to inject the brand file and slide design rules into generation prompts
GEN_V5=
# Python interpreter for ingest.py (needs PyMuPDF, python-pptx, python-docx, Pillow, optional Whisper)
INGEST_PY=
# Folder holding the external exporter scripts (export-deck.mjs, export-pptx-editable.mjs) and Playwright
EXPORT_DIR=
# Folder of brand assets copied into generated decks (logo, emblem, product screens)
BRAND_ASSETS_DIR=
# Folder of brand font files bundled into generated decks
BRAND_FONTS_DIR=
# Path to an optional Canva Connect helper script (Canva import is disabled in the relay)
CANVA_PY=
# Short brand tagline printed by the generator and the native PPTX mapper
BRAND_TAGLINE=
# sync-bundle.sh only: source folder of the external exporter scripts and their node_modules
EXPORT_SRC=
# sync-bundle.sh only: source folder of the optional Canva helper
CANVA_SRC=
# sync-bundle.sh only: source folder of the brand font files copied into the relay bundle
BRAND_FONTS_SRC=
# sync-bundle.sh only: source folder of the brand assets copied into the relay bundle
BRAND_ASSETS_SRC=
# Gamma API key for the legacy "Create with Gamma" path (build-gamma.mjs)
GAMMA_API_KEY=
# Gamma theme id applied to Gamma-built decks
GAMMA_THEME_ID=

# ---------------------------------------------------------------------------
# Engine v2 (engine/engine-v2)
# Also uses ANTHROPIC_API_KEY from above.
# ---------------------------------------------------------------------------
# Claude model id for composer/compose.mjs
COMPOSER_MODEL=

# ---------------------------------------------------------------------------
# Web deck templates (engine/web-deck), build time only
# ---------------------------------------------------------------------------
# Set to 1 to build a static export (next build -> out/)
DECK_EXPORT=
# URL base path the exported deck is served under, e.g. /p/_engage/deck
DECK_BASE_PATH=
# Prefix for _next assets (defaults to DECK_BASE_PATH)
ASSET_PREFIX=
# Same base path, exposed to client code
NEXT_PUBLIC_DECK_BASE_PATH=
# Optional JSON deck spec baked into the engage template at build time (preview without spec.json)
NEXT_PUBLIC_ENGAGE_SPEC=
# deploy-engage-template.sh only: ssh target of the VPS, e.g. deploy@<VPS_HOST> (also reads APP_DOMAIN)
VPS=
