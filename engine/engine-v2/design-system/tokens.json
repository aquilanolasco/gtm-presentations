{
  "$schema": "https://design-tokens.org/schema.json",
  "_note": "Acme brand tokens (neutral sample palette), three-layer. tokens.css is the rendered source of truth; this file feeds the token generator + PPTX/Canva renderers so all four outputs share one palette. Swap the primitive values for your own brand.",
  "primitive": {
    "color": {
      "purple": {
        "light": { "$value": "#8b5cf6", "$type": "color" },
        "core":  { "$value": "#8b5cf6", "$type": "color" }
      },
      "blue":  { "500": { "$value": "#3b82f6", "$type": "color" } },
      "green": { "500": { "$value": "#10b981", "$type": "color" } },
      "gray": {
        "50":  { "$value": "#f9fafb", "$type": "color" },
        "100": { "$value": "#f3f4f6", "$type": "color" },
        "200": { "$value": "#e5e7eb", "$type": "color" },
        "400": { "$value": "#9ca3af", "$type": "color" },
        "600": { "$value": "#4b5563", "$type": "color" },
        "900": { "$value": "#111827", "$type": "color" }
      },
      "soft": {
        "purple": { "$value": "#f5f3ff", "$type": "color" },
        "blue":   { "$value": "#eff6ff", "$type": "color" }
      },
      "white": { "$value": "#ffffff", "$type": "color" }
    },
    "gradient": {
      "brand": { "$value": "linear-gradient(90deg, #8b5cf6 0%, #8b5cf6 50%, #3b82f6 100%)", "$type": "gradient" },
      "soft":  { "$value": "linear-gradient(135deg, #f5f3ff 0%, #eff6ff 100%)", "$type": "gradient" }
    },
    "font": {
      "sans": { "$value": "Inter", "$type": "fontFamily" },
      "mono": { "$value": "JetBrains Mono", "$type": "fontFamily" },
      "onImage": { "$value": "Inter", "$type": "fontFamily", "_note": "ON-IMAGE typography ONLY. Never a web body/heading font." }
    }
  },
  "semantic": {
    "color": {
      "background":   { "$value": "{primitive.color.white}", "$type": "color" },
      "foreground":   { "$value": "{primitive.color.gray.900}", "$type": "color" },
      "body":         { "$value": "{primitive.color.gray.600}", "$type": "color" },
      "muted":        { "$value": "{primitive.color.gray.400}", "$type": "color" },
      "primary":      { "$value": "{primitive.color.purple.core}", "$type": "color" },
      "primary-alt":  { "$value": "{primitive.color.purple.light}", "$type": "color" },
      "accent":       { "$value": "{primitive.color.blue.500}", "$type": "color" },
      "success":      { "$value": "{primitive.color.green.500}", "$type": "color" },
      "border":       { "$value": "{primitive.color.gray.200}", "$type": "color" },
      "border-soft":  { "$value": "{primitive.color.gray.100}", "$type": "color" }
    }
  },
  "component": {
    "cta": {
      "bg":     { "$value": "{primitive.gradient.brand}", "$type": "gradient" },
      "fg":     { "$value": "{primitive.color.white}", "$type": "color" },
      "radius": { "$value": "999px", "$type": "dimension" },
      "nowrap": { "$value": "true", "$type": "other", "_note": "white-space:nowrap is mandatory on every CTA/pill." }
    },
    "card": {
      "bg":     { "$value": "{primitive.color.white}", "$type": "color" },
      "border": { "$value": "{semantic.color.border}", "$type": "color" },
      "radius": { "$value": "22px", "$type": "dimension" },
      "soft-bg":{ "$value": "{primitive.gradient.soft}", "$type": "gradient" }
    }
  }
}
